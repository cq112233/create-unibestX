import { tabbarList } from '@/src/tabbar/index.uts';

/**
 * 纯中文极简模式（未开启多语言）：直接返回文本，零外部插件与配置依赖
 */
export function t(key: string, _named: UTSJSONObject | null = null): string {
  return getI18nText(key);
}

export function $t(key: string, _named: UTSJSONObject | null = null): string {
  return getI18nText(key);
}

export function getI18nText(key: string): string {
  let clean = key;
  if (clean.startsWith('%') && clean.endsWith('%') && clean.length > 2) {
    clean = clean.substring(1, clean.length - 1);
  }
  if (clean === 'tabbar.home') return '首页';
  if (clean === 'tabbar.me') return '我的';
  if (clean === 'tabbar.basic') return '基础';
  if (clean === 'tabbar.function') return '功能';
  if (clean === 'tabbar.ai') return 'AI';
  return clean;
}

export function setTabbarItem(): void {
  for (let i = 0; i < tabbarList.length; i++) {
    const item = tabbarList[i];
    const text = getI18nText(item.text);
    uni.setTabBarItem({
      index: i,
      text
    } as SetTabBarItemOptions);
  }
}

export function setNavigationBarTitle(titleKey: string): void {
  const title = getI18nText(titleKey);
  uni.setNavigationBarTitle({
    title
  } as SetNavigationBarTitleOptions);
}
